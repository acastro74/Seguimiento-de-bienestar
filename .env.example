# Copia este archivo como .env.local y completa con los datos de tu proyecto Supabase
# (Supabase → Project Settings → API). Si los dejas vacíos, la app corre en "modo demo"
# guardando los datos solo en este navegador.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Opcional: muestra el botón "Continuar con Google" (requiere configurar el proveedor Google en Supabase)
VITE_ENABLE_GOOGLE=false
